# MemeClassroom — Environment Variables Template
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in your actual values.
# .env.local is git-ignored and will NEVER be committed to the repository.
#
# To use: create a file called .env.local in this same folder (project root)
# and paste in only the variables you need, with your real values.
# ─────────────────────────────────────────────────────────────────────────────

# ── Giphy GIF Search ──────────────────────────────────────────────────────────
# Required for the GIF search tab in the Meme Lab.
# Get a free key at: https://developers.giphy.com → Create App → API
VITE_GIPHY_API_KEY=your_giphy_api_key_here

# ── Google Gemini AI (Optional) ───────────────────────────────────────────────
# NOT recommended: setting this embeds your key in the public JavaScript bundle.
# Users can supply their own Gemini key via the AI settings modal.
# Only set this if you understand the implications (key will be publicly visible).
# VITE_GEMINI_API_KEY=

# ── Development Only ──────────────────────────────────────────────────────────
# Enables dev-mode auth bypass (only works when running `npm run dev`, never in production)
# VITE_DEV_MODE=true
