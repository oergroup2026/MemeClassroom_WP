# MemeClassroom Cloud Functions — Environment Variables Template
# Copy this file to functions/.env and fill in your actual values.
# functions/.env is git-ignored and will NEVER be committed to the repository.

# ── Error Tracking (Sentry, Optional) ──────────────────────────────────────
# When unset, error tracking is a no-op — functions run exactly as before.
# Get a free DSN at: https://sentry.io → Create Project (Node.js)
SENTRY_DSN=

# ── Gemini AI (Meme Lab AI captions/vision/quiz feedback) ──────────────────
# When unset, generateAiContent falls back to canned educational responses so
# the Meme Lab AI features still work end-to-end in dev/emulator without a key.
# Get a key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
