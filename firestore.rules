rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: any signed-in user
    function isLoggedIn() {
      return request.auth != null;
    }

    // Helper: the requesting user owns this document
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Helper: check if the requesting user has admin role
    function isAdmin() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Helper: check if user is expert or admin
    function isExpertOrAdmin() {
      return request.auth != null && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'expert' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    // Roles a user may assign to their OWN profile at registration. Must stay in
    // sync with REGISTER_ROLES in src/pages/Auth.jsx — the signup screen offers
    // exactly these five. Privileged roles ('expert', 'admin', 'manager') are
    // deliberately absent: they are granted by an admin only (see /expert_apps).
    function isSelfAssignableRole(role) {
      return role in ['student', 'teacher', 'research', 'parent', 'other'];
    }

    // Helper: check if the requesting user's own profile is banned.
    // Used to block content creation server-side — the app only redirects
    // banned users client-side (App.jsx), which a direct Firestore write bypasses.
    function isBanned() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.banned == true;
    }

    // Per-user daily caps. /user_quotas/{uid} is maintained only by Cloud
    // Functions (clients are denied all writes below), so this document can be
    // trusted here. blocked_until is always present and sits at epoch 0 while a
    // user is within their limits.
    //
    // Enforcement lags by one write — the function that counts a create runs
    // after it — so someone determined gets a handful past the cap before this
    // starts refusing. That is enough to bound the cost, which is the point.
    function notRateLimited() {
      return !exists(/databases/$(database)/documents/user_quotas/$(request.auth.uid)) ||
        get(/databases/$(database)/documents/user_quotas/$(request.auth.uid)).data.blocked_until < request.time;
    }

    // Counters (likes, views, flags, comments) are derived data. A new document
    // must start them at zero, otherwise anyone could publish a meme that
    // already claims 9,999 likes. Cloud Functions maintain likes_count and
    // view_count (see functions/derivedData.js); clients may only add +1 flags below.
    function startsWithZeroCounters() {
      return request.resource.data.get('likes_count', 0) == 0
        && request.resource.data.get('view_count', 0) == 0
        && request.resource.data.get('flag_count', 0) == 0
        && request.resource.data.get('comments_count', 0) == 0;
    }

    // ─── User Quotas ────────────────────────────────────────────────────────
    // Readable by the owner so the app can tell them why a post was refused,
    // and by admins for support. Written only by Cloud Functions, which use the
    // Admin SDK and bypass these rules — a client that could write this could
    // lift its own limit.
    match /user_quotas/{userId} {
      allow read: if isLoggedIn() && (isOwner(userId) || isAdmin());
      allow write: if false;
    }

    // ─── Users ──────────────────────────────────────────────────────────────
    // This document holds the user's school/institution, town, state and
    // country. It was readable by ANY signed-in user, so since registration is
    // open to the public, anyone could enumerate the name, school and location
    // of every student on the platform.
    //
    // Reads are now limited to the owner and admins. Pages that just need to
    // show an author's name and avatar read /user_cards/{uid} instead, which a
    // Cloud Function mirrors from this document (see functions/index.js).
    //
    // Admins can read and write any profile. Non-admin users can only create/update
    // their own profile with a self-assignable role, and cannot self-grant admin,
    // expert, verified, or banned status.
    match /users/{userId} {
      allow read: if isLoggedIn() && (isOwner(userId) || isAdmin());
      allow create: if isLoggedIn() && (
        isAdmin() ||
        (isOwner(userId) && isSelfAssignableRole(request.resource.data.role)
          // The update rule below guards these fields, but create did not, so a
          // new signup could simply be born verified (or pre-cleared of a ban).
          && request.resource.data.get('is_verified', false) == false
          && request.resource.data.get('banned', false) == false)
      );
      allow update: if isLoggedIn() && (
        isAdmin() ||
        (isOwner(userId) && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'is_verified', 'banned'])
        ))
      );
      allow delete: if isAdmin();

      // Private subcollection for sensitive PII (ID Card verification URL, etc.)
      match /private/{docId} {
        allow read, write: if isLoggedIn() && (isOwner(userId) || isAdmin());
      }
    }

    // ─── Public Profile Cards ─────────────────────────────────────────────────
    // The display-only projection of /users/{uid}: name, role, is_verified,
    // avatar_url, tagline. Nothing here identifies where a user studies or
    // lives. Written ONLY by the mirrorUserCard Cloud Function, which runs with
    // the Admin SDK and bypasses these rules — clients are denied all writes, so
    // a user cannot forge or alter another user's card.
    //
    // Public read, per the project's access policy: all content is browsable
    // without an account and only contributing requires one. Memes, resources
    // and comments are already public, so their author attribution must be too
    // — the old rule required a login, which left every guest looking at
    // "Unknown User" on otherwise public pages.
    match /user_cards/{userId} {
      allow read: if true;
      allow write: if false;
    }

    // ─── Private Contacts (email addresses) ───────────────────────────────────
    // Email lives here instead of on /users/{userId} so that the "any logged-in
    // user can read /users" rule above doesn't hand every authenticated user
    // everyone else's email address. Owner + admin only.
    match /private_contacts/{userId} {
      allow read, write: if isLoggedIn() && (isOwner(userId) || isAdmin());
    }

    // ─── Memes ──────────────────────────────────────────────────────────────
    // Public memes are readable by all (including guests browsing the library).
    // Private/draft memes are only readable by their creator or admin.
    match /memes/{memeId} {
      allow read: if resource.data.visibility == "public" || (
        isLoggedIn() && (
          resource.data.creator_id == request.auth.uid ||
          isAdmin()
        )
      );
      allow create: if isLoggedIn() && !isBanned() && notRateLimited()
        && request.resource.data.creator_id == request.auth.uid
        && startsWithZeroCounters();
      allow update: if isLoggedIn() && (
        isAdmin() ||
        // The creator may edit their own meme, but not its counters —
        // otherwise anyone whose content was reported could simply zero their
        // own flag_count, or give their own meme a million likes/views.
        // likes_count is maintained only by Cloud Functions (derivedData.js).
        (
          resource.data.creator_id == request.auth.uid &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['flag_count', 'likes_count', 'view_count'])
        ) ||
        // Reporting is increment-only. Allowing -1 let anyone repeatedly
        // decrement a reported item's counter and un-report it; the client only
        // ever increments. Clearing a flag after review is an admin action.
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['flag_count']) &&
          request.resource.data.flag_count == resource.data.flag_count + 1
        )
        // view_count is counted by a Cloud Function from /views receipts.
      );
      allow delete: if isLoggedIn() && (
        resource.data.creator_id == request.auth.uid || isAdmin()
      );
    }

    // ─── Templates ──────────────────────────────────────────────────────────
    // Only approved templates are publicly visible (including to unauthenticated guests).
    // Any authenticated user can contribute (create) a template for approval.
    // Only admins can approve, update status, or delete templates.
    match /templates/{templateId} {
      allow read: if resource.data.status == "approved" || (
        isLoggedIn() && (
          resource.data.creator_id == request.auth.uid ||
          isAdmin()
        )
      );
      // Creation previously required only being signed in, with no check on
      // creator_id or status — so a user could submit a template already marked
      // status: "approved" and publish it straight to the public library, which
      // guests can read. Contributors must now claim their own submission and
      // leave it unapproved; only admins can create an approved template.
      allow create: if isLoggedIn() && !isBanned() && (
        isAdmin() ||
        (
          request.resource.data.creator_id == request.auth.uid &&
          request.resource.data.status != "approved"
        )
      );
      allow update, delete: if isAdmin();
    }

    // ─── Taxonomy Counters ───────────────────────────────────────────────────
    // Authenticated users can write counts; only admin reads all counts.
    match /custom_counts/{docId} {
      // The app reads the counter inside its own transaction, so signed-in users
      // need read access (admin-only read made that transaction always fail).
      // Writes may only start a counter at 1 or add exactly 1 — nobody can set
      // an arbitrary number to force a custom subject into the shared taxonomy.
      allow read: if isLoggedIn();
      allow create: if isLoggedIn() && request.resource.data.count == 1;
      allow update: if isLoggedIn() && request.resource.data.count == resource.data.count + 1;
      allow delete: if isAdmin();
    }

    // ─── Shared Config (taxonomy, etc.) ─────────────────────────────────────
    match /configs/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── User Stats ──────────────────────────────────────────────────────────
    // These numbers drive badges, so they must come from real actions. They are
    // written only by Cloud Functions (functions/derivedData.js), which bypass
    // these rules; admins keep write access for support and seeding.
    match /user_stats/{userId} {
      allow read: if isLoggedIn();
      allow write: if isAdmin();
    }

    // ─── Expert Applications ──────────────────────────────────────────────────
    match /expert_apps/{appId} {
      allow read, update, delete: if isAdmin();
      allow create: if isLoggedIn() && request.resource.data.user_id == request.auth.uid;
    }

    // ─── Comments ───────────────────────────────────────────────────────────
    // Only an expert/admin may mark a comment as an expert comment.
    function expertFlagIsPermitted() {
      return !request.resource.data.keys().hasAll(['is_expert_comment']) ||
             request.resource.data.is_expert_comment != true ||
             isExpertOrAdmin();
    }

    match /comments/{commentId} {
      allow read: if true;
      allow create: if isLoggedIn() && !isBanned() && notRateLimited()
        && request.resource.data.user_id == request.auth.uid
        && expertFlagIsPermitted();
      // Editing previously required only "signed in and not banned" — with no
      // check that you wrote the comment, any user could rewrite anyone else's
      // words while their name stayed on it. Restrict to the author (and
      // admins, for moderation), and do not let an edit reassign authorship.
      allow update: if isLoggedIn() && !isBanned()
        && expertFlagIsPermitted()
        && (
          isAdmin() ||
          (
            resource.data.user_id == request.auth.uid &&
            request.resource.data.user_id == resource.data.user_id
          )
        );
      allow delete: if isLoggedIn() && resource.data.user_id == request.auth.uid;
      allow delete: if isAdmin();
    }

    // ─── Staffroom Posts ─────────────────────────────────────────────────────
    // Public read, per the project's access policy: all content is browsable
    // without an account and only contributing requires one. Posting, replying,
    // voting and reacting all still require a signed-in, non-banned user below.
    // Non-author writes to a Staffroom post. Each is the exact change the
    // Staffroom page makes, and nothing else.
    function staffroomChanged() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }
    // Reporting: +1 only, like /memes.
    function isStaffroomReport() {
      return staffroomChanged().hasOnly(['flag_count'])
        && request.resource.data.flag_count == resource.data.get('flag_count', 0) + 1;
    }
    // Poll vote: adds exactly the caller to poll_voted_users, once, and adds 1
    // to exactly one option's tally. Polls have at most 6 options ("0"–"5",
    // the Staffroom composer's limit); every tally may only stay or go up by 1,
    // and only one may change.
    function isStaffroomPollVote() {
      let before = resource.data.get('poll_votes', {});
      let after = request.resource.data.get('poll_votes', {});
      return staffroomChanged().hasOnly(['poll_votes', 'poll_voted_users'])
        && !(request.auth.uid in resource.data.get('poll_voted_users', []))
        && request.resource.data.poll_voted_users.toSet()
             == resource.data.get('poll_voted_users', []).toSet().union([request.auth.uid].toSet())
        && after.diff(before).affectedKeys().size() == 1
        && after.diff(before).affectedKeys().hasOnly(['0', '1', '2', '3', '4', '5'])
        && tallyUpByOne(before, after, '0') && tallyUpByOne(before, after, '1')
        && tallyUpByOne(before, after, '2') && tallyUpByOne(before, after, '3')
        && tallyUpByOne(before, after, '4') && tallyUpByOne(before, after, '5');
    }
    function tallyUpByOne(before, after, key) {
      return after.get(key, 0) == before.get(key, 0) || after.get(key, 0) == before.get(key, 0) + 1;
    }
    // Emoji reaction: the caller's own reaction_by_<uid> key, and each tally of
    // the Staffroom's six emojis (REACTION_EMOJIS in Staffroom.jsx) moves by at
    // most 1 (one goes up, the previous one comes down) — at most two change.
    function isStaffroomReaction() {
      let before = resource.data.get('reactions', {});
      let after = request.resource.data.get('reactions', {});
      return staffroomChanged().hasOnly(['reactions', 'reaction_by_' + request.auth.uid])
        && after.diff(before).affectedKeys().size() <= 2
        && after.diff(before).affectedKeys().hasOnly(['👍', '❤️', '💡', '👏', '🔥', '😮'])
        && reactionStep(before, after, '👍') && reactionStep(before, after, '❤️')
        && reactionStep(before, after, '💡') && reactionStep(before, after, '👏')
        && reactionStep(before, after, '🔥') && reactionStep(before, after, '😮');
    }
    function reactionStep(before, after, emoji) {
      let was = before.get(emoji, 0);
      let now = after.get(emoji, 0);
      return now is int && now >= 0 && (now == was || now == was + 1 || now == was - 1);
    }

    match /staffroom_posts/{postId} {
      allow read: if true;
      // author_id must be the caller, otherwise anyone could post in another
      // user's name (the author's name/avatar is looked up from this field).
      allow create: if isLoggedIn() && !isBanned() && notRateLimited()
        && request.resource.data.author_id == request.auth.uid
        && request.resource.data.get('likes', 0) == 0
        && request.resource.data.get('liked_by', []).size() == 0
        && request.resource.data.get('flag_count', 0) == 0
        && request.resource.data.get('poll_voted_users', []).size() == 0;
      allow update: if isLoggedIn() && (
        // The author may edit their post, but not its counters or who voted.
        (
          resource.data.author_id == request.auth.uid &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['author_id', 'likes', 'liked_by', 'flag_count', 'poll_votes', 'poll_voted_users', 'reactions'])
        ) ||
        isAdmin() ||
        // Everyone else gets an allowlist, not a denylist: previously any
        // signed-in user could set likes to 9999, edit liked_by, zero
        // flag_count to un-report a post, or rewrite poll results.
        // Upvotes (likes / liked_by) are Cloud Functions only (/staffroom_likes).
        isStaffroomReport() || isStaffroomPollVote() || isStaffroomReaction()
      );
      allow delete: if isLoggedIn() && resource.data.author_id == request.auth.uid;
      allow delete: if isAdmin();
    }

    // ─── Staffroom Upvotes ───────────────────────────────────────────────────
    // One doc per person per post ({uid}_{postId}); likes / liked_by on the
    // post follow these docs via Cloud Functions (derivedData.js).
    match /staffroom_likes/{likeId} {
      allow read: if isLoggedIn();
      allow create: if isLoggedIn() && !isBanned() && request.resource.data.user_id == request.auth.uid
        && likeId == request.auth.uid + '_' + request.resource.data.post_id
        && request.resource.data.get('backfilled', false) == false;
      allow delete: if isLoggedIn() && (resource.data.user_id == request.auth.uid || isAdmin());
    }

    // ─── Staffroom Replies ───────────────────────────────────────────────────
    // Public read, same policy as the posts they belong to.
    match /staffroom_replies/{replyId} {
      allow read: if true;
      allow create: if isLoggedIn() && !isBanned()
        && request.resource.data.author_id == request.auth.uid;
      allow update: if isLoggedIn() && (resource.data.author_id == request.auth.uid || isAdmin());
      allow delete: if isLoggedIn() && resource.data.author_id == request.auth.uid;
      allow delete: if isAdmin() || isExpertOrAdmin();
    }

    // ─── Resources ───────────────────────────────────────────────────────────
    // Author cannot self-approve on create, and cannot flip admin_approved to
    // true on update — mirrors the /newspaper_items pattern below, closing the
    // self-approval gap this file used to call out in a comment but not fix.
    match /resources/{resourceId} {
      allow read: if true;
      allow create: if isLoggedIn() && !isBanned() && notRateLimited() && (
        isAdmin() ||
        (request.resource.data.author_id == request.auth.uid && request.resource.data.admin_approved == false
          && startsWithZeroCounters())
      );
      allow update: if isLoggedIn() && (
        isAdmin() ||
        (
          resource.data.author_id == request.auth.uid &&
          (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['admin_approved']) ||
            request.resource.data.admin_approved == false
          ) &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'author_id', 'flag_count', 'likes_count', 'view_count', 'comments_count'])
        ) ||
        // Reporting a resource (ActivityDetail, MemeStoryDetail, Resources) is
        // an increment by a user who is NOT the author, which the author-only
        // clause above rejected — so flagging a resource silently failed for
        // everyone it was meant for. Increment-only, like /memes.
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['flag_count']) &&
          request.resource.data.flag_count == resource.data.flag_count + 1
        ) ||
        // Comment counter maintained by activity commenters, likewise not the author.
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['comments_count']) &&
          (request.resource.data.comments_count == resource.data.comments_count + 1 ||
           request.resource.data.comments_count == resource.data.comments_count - 1)
        )
      );
      allow delete: if isLoggedIn() && (resource.data.author_id == request.auth.uid || isAdmin());
    }

    // ─── External Links / Additional Tools ────────────────────────────────────
    // Publicly readable, so an unapproved entry is a link shown to students.
    // Creation previously required only being signed in, with no check on
    // contributor_id and no approval gate. Contributors must now claim their own
    // submission, leave it unapproved, and cannot self-approve on update.
    match /external_links/{linkId} {
      allow read: if true;
      allow create: if isLoggedIn() && !isBanned() && (
        isAdmin() ||
        (
          request.resource.data.contributor_id == request.auth.uid &&
          request.resource.data.admin_approved == false
        )
      );
      allow update: if isLoggedIn() && (
        isAdmin() ||
        (
          resource.data.contributor_id == request.auth.uid &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['admin_approved', 'contributor_id'])
        )
      );
      allow delete: if isLoggedIn() && (resource.data.contributor_id == request.auth.uid || isAdmin());
    }

    // ─── Newspaper Items ───────────────────────────────────────────────────────
    // Public read (including guests). Any logged-in user can submit, but only
    // admins can flip admin_approved/status — closes the gap that exists on
    // /resources today where an author can self-approve their own submission.
    match /newspaper_items/{itemId} {
      allow read: if true;
      allow create: if isLoggedIn() && !isBanned() && (
        isAdmin() ||
        (request.resource.data.author_id == request.auth.uid && request.resource.data.admin_approved == false
          && startsWithZeroCounters())
      );
      allow update: if isLoggedIn() && (
        isAdmin() ||
        (
          resource.data.author_id == request.auth.uid &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['admin_approved', 'status', 'author_id', 'view_count', 'likes_count', 'flag_count'])
        ) ||
        // Reporting, increment-only, as on /memes and /resources.
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['flag_count']) &&
          request.resource.data.flag_count == resource.data.get('flag_count', 0) + 1
        )
      );
      allow delete: if isLoggedIn() && (resource.data.author_id == request.auth.uid || isAdmin());
    }

    // ─── Newspaper Likes ─────────────────────────────────────────────────────
    // Like documents: the id must be {uid}_{target} so a person can like a thing
    // once, and an update may not retarget the like (Cloud Functions adjust the
    // counters on create/delete using these fields).
    match /newspaper_likes/{likeId} {
      allow read: if isLoggedIn();
      allow create: if isLoggedIn() && request.resource.data.user_id == request.auth.uid
        && likeId == request.auth.uid + '_' + request.resource.data.item_id;
      allow update: if isLoggedIn() && resource.data.user_id == request.auth.uid
        && request.resource.data.user_id == resource.data.user_id
        && request.resource.data.item_id == resource.data.item_id;
      allow delete: if isLoggedIn() && (resource.data.user_id == request.auth.uid || isAdmin());
    }

    // ─── Saves (Bookmarks) ───────────────────────────────────────────────────
    match /saves/{saveId} {
      allow read: if isLoggedIn() && (resource.data.user_id == request.auth.uid || isAdmin());
      allow create: if isLoggedIn() && request.resource.data.user_id == request.auth.uid;
      allow update, delete: if isLoggedIn() && (resource.data.user_id == request.auth.uid || isAdmin());
    }

    // ─── Resource Likes ──────────────────────────────────────────────────────
    match /resource_likes/{likeId} {
      allow read: if isLoggedIn();
      allow create: if isLoggedIn() && request.resource.data.user_id == request.auth.uid
        && likeId == request.auth.uid + '_' + request.resource.data.resource_id;
      allow update: if isLoggedIn() && resource.data.user_id == request.auth.uid
        && request.resource.data.user_id == resource.data.user_id
        && request.resource.data.resource_id == resource.data.resource_id;
      allow delete: if isLoggedIn() && (resource.data.user_id == request.auth.uid || isAdmin());
    }

    // ─── Likes ───────────────────────────────────────────────────────────────
    match /likes/{likeId} {
      allow read: if isLoggedIn();
      allow create: if isLoggedIn() && request.resource.data.user_id == request.auth.uid
        && likeId == request.auth.uid + '_' + request.resource.data.meme_id;
      allow delete: if isLoggedIn() && (resource.data.user_id == request.auth.uid || isAdmin());
    }

    // ─── View Receipts ───────────────────────────────────────────────────────
    // One receipt per signed-in person per item ({uid}_{kind}_{itemId}). A
    // second create of the same id is an update, which is denied, so a person
    // can add at most one view to an item. view_count follows these receipts
    // via a Cloud Function; clients cannot write view_count at all.
    match /views/{viewId} {
      allow read: if isLoggedIn() && resource.data.user_id == request.auth.uid;
      allow create: if isLoggedIn() && request.resource.data.user_id == request.auth.uid
        && request.resource.data.kind in ['memes', 'resources', 'newspaper_items']
        && request.resource.data.item_id is string
        && viewId == request.auth.uid + '_' + request.resource.data.kind + '_' + request.resource.data.item_id;
    }

    // ─── Ratings ─────────────────────────────────────────────────────────────
    match /ratings/{ratingId} {
      allow read: if true;
      // One rating document per person per meme ({uid}_{memeId}), so the
      // "ratings given" stat (counted on create by a Cloud Function) can't be
      // inflated by writing endless rating documents.
      allow create: if isLoggedIn() && request.resource.data.user_id == request.auth.uid
        && ratingId == request.auth.uid + '_' + request.resource.data.meme_id;
      allow update: if isLoggedIn() && request.resource.data.user_id == request.auth.uid
        && resource.data.user_id == request.auth.uid;
      allow delete: if isLoggedIn() && (resource.data.user_id == request.auth.uid || isAdmin());
    }

    // ─── Flags (Reports) ─────────────────────────────────────────────────────
    match /flags/{flagId} {
      allow read: if isLoggedIn() && (resource.data.reporter_id == request.auth.uid || isAdmin());
      allow create: if isLoggedIn() && request.resource.data.reporter_id == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // ─── Literacy Tests ────────────────────────────────────────────────────────
    // Active tests are publicly readable; only admins can create/update/delete.
    match /literacy_tests/{testId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ─── Literacy Test Questions ───────────────────────────────────────────────
    // The documents hold the correct answers, so only admins (the editor) read
    // them. Players get the questions without answers from the startQuiz
    // Cloud Function (functions/quizzes.js), which grades them too.
    match /literacy_test_questions/{questionId} {
      allow read: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // ─── Literacy Test Results ────────────────────────────────────────────────
    // Written only by finishQuiz from answers it graded itself; a browser that
    // could write here could simply claim a pass.
    match /literacy_test_results/{resultId} {
      allow read: if isLoggedIn() && (resource.data.user_id == request.auth.uid || isAdmin());
      allow create: if false;
      allow update, delete: if isAdmin();
    }

    // ─── Literacy Badges ──────────────────────────────────────────────────────
    // Awarded only by finishQuiz on a server-graded pass.
    match /literacy_badges/{badgeId} {
      allow read: if isLoggedIn() && (resource.data.user_id == request.auth.uid || isAdmin());
      allow create: if false;
      allow update, delete: if isAdmin();
    }

    // ─── Quiz Attempts ────────────────────────────────────────────────────────
    // Hold each attempt's answer key; Cloud Functions only.
    match /quiz_attempts/{attemptId} {
      allow read, write: if false;
    }

    // ─── Slang Terms (Slang Decoder dictionary) ───────────────────────────────
    // Public read (anyone can browse approved entries; the client filters to
    // status == "approved" for the public grid). Contributors can create their
    // own pending entry but cannot self-approve; admins can approve/edit/delete any.
    match /slang_terms/{termId} {
      allow read: if true;
      allow create: if isLoggedIn() && !isBanned() && (
        isAdmin() ||
        (request.resource.data.contributor_id == request.auth.uid && request.resource.data.admin_approved == false)
      );
      allow update: if isLoggedIn() && (
        isAdmin() ||
        (
          resource.data.contributor_id == request.auth.uid &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['admin_approved', 'status', 'contributor_id'])
        )
      );
      allow delete: if isLoggedIn() && (resource.data.contributor_id == request.auth.uid || isAdmin());
    }

    // ─── Slang Quiz Questions ──────────────────────────────────────────────────
    // Curated question bank for the Slang Decoder quiz. Holds the answers, so
    // admin-only like literacy questions; players are served by startQuiz.
    match /slang_quiz_questions/{questionId} {
      allow read: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // ─── Slang Quiz Results ────────────────────────────────────────────────────
    // Written only by finishQuiz, which also decides whether the attempt counts
    // toward Slang Master (passed, at most 3 a day).
    match /slang_quiz_results/{resultId} {
      allow read: if isLoggedIn() && (resource.data.user_id == request.auth.uid || isAdmin());
      allow create: if false;
      allow update, delete: if isAdmin();
    }

    // ─── Notifications ────────────────────────────────────────────────────────
    // Users can read and mark-as-read their own notifications only.
    // Cloud Functions (service account) create/delete — not direct client writes.
    match /notifications/{notifId} {
      allow read: if isLoggedIn() && resource.data.user_id == request.auth.uid;
      allow update: if isLoggedIn() && resource.data.user_id == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow create, delete: if false; // Written only by Cloud Functions service account
    }

    // ─── Unban Requests ───────────────────────────────────────────────────────
    match /unban_requests/{reqId} {
      // Appeals contain the user's explanation and email, so only the appellant
      // (doc id == their uid) and admins may read or write them. Previously any
      // signed-in user could read everyone's appeals or overwrite someone else's.
      allow read: if isLoggedIn() && (request.auth.uid == reqId || isAdmin());
      allow create, update: if isLoggedIn() && (request.auth.uid == reqId || isAdmin());
      allow delete: if isAdmin();
    }

    // ─── Badges ──────────────────────────────────────────────────────────────
    // Awarded by awardBadgeIfMissing() in src/utils/badges.js, which first
    // queries this collection for the signed-in user's existing badges and then
    // creates one. With no rule here the whole gamification system failed
    // silently — every read and write was denied by default and the helper
    // swallowed the error, so no badge was ever awarded to anyone.
    // Readable by signed-in users (profiles display other users' badges);
    // a user may only create badges for themselves. Edits/removals are admin-only
    // so a user cannot retroactively rewrite their own achievements.
    match /badges/{badgeId} {
      allow read: if isLoggedIn();
      // Every badge is awarded by a Cloud Function: level and Contributor
      // badges by syncBadges (derivedData.js), literacy badges by finishQuiz
      // (quizzes.js) on a server-graded pass. Clients create none.
      allow create: if isAdmin();
      allow update, delete: if isAdmin();
    }

    // ─── Activity Comments ────────────────────────────────────────────────────
    // Comments on an activity resource (ActivityDetail.jsx). Activities are
    // publicly readable, so comments are too. Authors may delete their own;
    // admins may moderate any. Note this collection uses author_id, unlike
    // /comments which uses user_id.
    match /activity_comments/{commentId} {
      allow read: if true;
      allow create: if isLoggedIn() && !isBanned() && request.resource.data.author_id == request.auth.uid;
      allow update: if isLoggedIn() && (resource.data.author_id == request.auth.uid || isAdmin());
      allow delete: if isLoggedIn() && (resource.data.author_id == request.auth.uid || isAdmin());
    }

    // ─── Legacy Threads (global search index only) ────────────────────────────
    // Navbar.jsx reads this inside a Promise.all alongside memes and resources.
    // Without a rule the denial rejected the whole batch, so the global search
    // box indexed nothing at all — not even memes. Read-only for clients.
    match /threads/{threadId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── Homepage Hero Cards, Sponsored Ads, Testimonials ─────────────────────
    // All three are published from the Admin panel and displayed publicly on the
    // homepage, so: public read, admin-only write.
    match /heroCards/{cardId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /sponsored_ads/{adId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /testimonials/{testimonialId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── Content Highlights ────────────────────────────────────────────────────
    // Admin-curated picks shown in the homepage highlights carousel and the
    // Newspaper page's hero. Each doc is a denormalized snapshot pointing at a
    // piece of content elsewhere (newspaper_items, resources, memes,
    // staffroom_posts) — public read, admin-only write, same as the other
    // curated-for-the-public collections above.
    match /content_highlights/{highlightId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── Admin Notifications ──────────────────────────────────────────────────
    match /admin_notifications/{notifId} {
      allow read, update, delete: if isAdmin();
      // Must be about yourself, so nobody can fake alerts in another user's name.
      allow create: if isLoggedIn() && request.resource.data.user_id == request.auth.uid;
    }

  }
}
