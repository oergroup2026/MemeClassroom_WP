rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: any signed-in user
    function isLoggedIn() {
      return request.auth != null;
    }

    // Helper: the requesting user owns this document
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Helper: check if the requesting user has admin role
    function isAdmin() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Helper: check if user is expert or admin
    function isExpertOrAdmin() {
      return request.auth != null && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'expert' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    // ─── Users ──────────────────────────────────────────────────────────────
    // Profiles require authentication to read — prevents anonymous visitors from
    // scraping email addresses or other personal details.
    // Admins can read and write any profile. Non-admin users can only create/update their own
    // profile with allowed roles (student/teacher) and cannot self-grant admin, expert, verified, or banned status.
    match /users/{userId} {
      allow read: if isLoggedIn();
      allow create: if isLoggedIn() && (
        isAdmin() ||
        (isOwner(userId) && request.resource.data.role in ['student', 'teacher'])
      );
      allow update: if isLoggedIn() && (
        isAdmin() ||
        (isOwner(userId) && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'is_verified', 'banned'])
        ))
      );
      allow delete: if isAdmin();

      // Private subcollection for sensitive PII (ID Card verification URL, etc.)
      match /private/{docId} {
        allow read, write: if isLoggedIn() && (isOwner(userId) || isAdmin());
      }
    }

    // ─── Memes ──────────────────────────────────────────────────────────────
    // Public memes are readable by all (including guests browsing the library).
    // Private/draft memes are only readable by their creator or admin.
    match /memes/{memeId} {
      allow read: if resource.data.visibility == "public" || (
        isLoggedIn() && (
          resource.data.creator_id == request.auth.uid ||
          isAdmin()
        )
      );
      allow create: if isLoggedIn() && request.resource.data.creator_id == request.auth.uid;
      allow update: if isLoggedIn() && (
        resource.data.creator_id == request.auth.uid ||
        isAdmin() ||
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes_count']) &&
          (request.resource.data.likes_count == resource.data.likes_count + 1 || request.resource.data.likes_count == resource.data.likes_count - 1)
        ) ||
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['flag_count']) &&
          (request.resource.data.flag_count == resource.data.flag_count + 1 || request.resource.data.flag_count == resource.data.flag_count - 1)
        )
      );
      allow delete: if isLoggedIn() && (
        resource.data.creator_id == request.auth.uid || isAdmin()
      );
    }

    // ─── Templates ──────────────────────────────────────────────────────────
    // Only approved templates are publicly visible (including to unauthenticated guests).
    // Any authenticated user can contribute (create) a template for approval.
    // Only admins can approve, update status, or delete templates.
    match /templates/{templateId} {
      allow read: if resource.data.status == "approved" || (
        isLoggedIn() && (
          resource.data.creator_id == request.auth.uid ||
          isAdmin()
        )
      );
      allow create: if isLoggedIn();
      allow update, delete: if isAdmin();
    }

    // ─── Taxonomy Counters ───────────────────────────────────────────────────
    // Authenticated users can write counts; only admin reads all counts.
    match /custom_counts/{docId} {
      allow read: if isAdmin();
      allow write: if isLoggedIn();
    }

    // ─── Shared Config (taxonomy, etc.) ─────────────────────────────────────
    match /configs/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── User Stats ──────────────────────────────────────────────────────────
    match /user_stats/{userId} {
      allow read: if isLoggedIn();
      allow create: if isLoggedIn() && (isOwner(userId) || isAdmin());
      allow update: if isLoggedIn() && (
        isOwner(userId) ||
        isAdmin() ||
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['total_likes_received']) &&
          (request.resource.data.total_likes_received == resource.data.total_likes_received + 1 || request.resource.data.total_likes_received == resource.data.total_likes_received - 1)
        )
      );
      allow delete: if isLoggedIn() && (isOwner(userId) || isAdmin());
    }

    // ─── Expert Applications ──────────────────────────────────────────────────
    match /expert_apps/{appId} {
      allow read, update, delete: if isAdmin();
      allow create: if isLoggedIn() && request.resource.data.user_id == request.auth.uid;
    }

    // ─── Comments ───────────────────────────────────────────────────────────
    match /comments/{commentId} {
      allow read: if true;
      allow create, update: if isLoggedIn() && (
        !request.resource.data.keys().hasAll(['is_expert_comment']) ||
        request.resource.data.is_expert_comment != true ||
        isExpertOrAdmin()
      );
      allow delete: if isLoggedIn() && resource.data.user_id == request.auth.uid;
      allow delete: if isAdmin();
    }

    // ─── Staffroom Posts ─────────────────────────────────────────────────────
    match /staffroom_posts/{postId} {
      allow read: if isLoggedIn();
      allow create: if isLoggedIn();
      allow update: if isLoggedIn() && (
        resource.data.author_id == request.auth.uid ||
        isAdmin() ||
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['title', 'body', 'author_id', 'post_type', 'attachment_url', 'attachment_name', 'created_at', 'subject', 'grade', 'is_solved', 'is_announcement'])
      );
      allow delete: if isLoggedIn() && resource.data.author_id == request.auth.uid;
      allow delete: if isAdmin();
    }

    // ─── Staffroom Replies ───────────────────────────────────────────────────
    match /staffroom_replies/{replyId} {
      allow read: if isLoggedIn();
      allow create: if isLoggedIn();
      allow update: if isLoggedIn() && (resource.data.author_id == request.auth.uid || isAdmin());
      allow delete: if isLoggedIn() && resource.data.author_id == request.auth.uid;
      allow delete: if isAdmin() || isExpertOrAdmin();
    }

    // ─── Resources ───────────────────────────────────────────────────────────
    match /resources/{resourceId} {
      allow read: if true;
      allow create: if isLoggedIn();
      allow update, delete: if isLoggedIn() && (resource.data.author_id == request.auth.uid || isAdmin());
    }

    // ─── External Links / Additional Tools ────────────────────────────────────
    match /external_links/{linkId} {
      allow read: if true;
      allow create: if isLoggedIn();
      allow update, delete: if isLoggedIn() && (resource.data.contributor_id == request.auth.uid || isAdmin());
    }

    // ─── Newspaper Items ───────────────────────────────────────────────────────
    // Public read (including guests). Any logged-in user can submit, but only
    // admins can flip admin_approved/status — closes the gap that exists on
    // /resources today where an author can self-approve their own submission.
    match /newspaper_items/{itemId} {
      allow read: if true;
      allow create: if isLoggedIn() && (
        isAdmin() ||
        (request.resource.data.author_id == request.auth.uid && request.resource.data.admin_approved == false)
      );
      allow update: if isLoggedIn() && (
        isAdmin() ||
        (
          resource.data.author_id == request.auth.uid &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['admin_approved', 'status', 'author_id', 'view_count', 'likes_count', 'flag_count'])
        )
      );
      allow delete: if isLoggedIn() && (resource.data.author_id == request.auth.uid || isAdmin());
    }

    // ─── Newspaper Likes ─────────────────────────────────────────────────────
    match /newspaper_likes/{likeId} {
      allow read: if isLoggedIn();
      allow create: if isLoggedIn() && request.resource.data.user_id == request.auth.uid;
      allow update, delete: if isLoggedIn() && (resource.data.user_id == request.auth.uid || isAdmin());
    }

    // ─── Saves (Bookmarks) ───────────────────────────────────────────────────
    match /saves/{saveId} {
      allow read: if isLoggedIn() && (resource.data.user_id == request.auth.uid || isAdmin());
      allow create: if isLoggedIn() && request.resource.data.user_id == request.auth.uid;
      allow update, delete: if isLoggedIn() && (resource.data.user_id == request.auth.uid || isAdmin());
    }

    // ─── Resource Likes ──────────────────────────────────────────────────────
    match /resource_likes/{likeId} {
      allow read: if isLoggedIn();
      allow create: if isLoggedIn() && request.resource.data.user_id == request.auth.uid;
      allow update, delete: if isLoggedIn() && (resource.data.user_id == request.auth.uid || isAdmin());
    }

    // ─── Likes ───────────────────────────────────────────────────────────────
    match /likes/{likeId} {
      allow read: if isLoggedIn();
      allow create: if isLoggedIn() && request.resource.data.user_id == request.auth.uid;
      allow delete: if isLoggedIn() && (resource.data.user_id == request.auth.uid || isAdmin());
    }

    // ─── Ratings ─────────────────────────────────────────────────────────────
    match /ratings/{ratingId} {
      allow read: if true;
      allow create, update: if isLoggedIn() && request.resource.data.user_id == request.auth.uid;
      allow delete: if isLoggedIn() && (resource.data.user_id == request.auth.uid || isAdmin());
    }

    // ─── Flags (Reports) ─────────────────────────────────────────────────────
    match /flags/{flagId} {
      allow read: if isLoggedIn() && (resource.data.reporter_id == request.auth.uid || isAdmin());
      allow create: if isLoggedIn() && request.resource.data.reporter_id == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // ─── Literacy Tests ────────────────────────────────────────────────────────
    // Active tests are publicly readable; only admins can create/update/delete.
    match /literacy_tests/{testId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ─── Literacy Test Questions ───────────────────────────────────────────────
    // Questions are publicly readable (needed to run the quiz); only admins can write.
    match /literacy_test_questions/{questionId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ─── Literacy Test Results ────────────────────────────────────────────────
    // Users can write only their own results; they can read their own results; admins see all.
    match /literacy_test_results/{resultId} {
      allow read: if isLoggedIn() && (resource.data.user_id == request.auth.uid || isAdmin());
      allow create: if isLoggedIn() && request.resource.data.user_id == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // ─── Literacy Badges ──────────────────────────────────────────────────────
    // Users earn badges on passing tests; they can read their own; admins see all.
    match /literacy_badges/{badgeId} {
      allow read: if isLoggedIn() && (resource.data.user_id == request.auth.uid || isAdmin());
      allow create: if isLoggedIn() && request.resource.data.user_id == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // ─── Notifications ────────────────────────────────────────────────────────
    // Users can read and mark-as-read their own notifications only.
    // Cloud Functions (service account) create/delete — not direct client writes.
    match /notifications/{notifId} {
      allow read: if isLoggedIn() && resource.data.user_id == request.auth.uid;
      allow update: if isLoggedIn() && resource.data.user_id == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow create, delete: if false; // Written only by Cloud Functions service account
    }

    // ─── Unban Requests ───────────────────────────────────────────────────────
    match /unban_requests/{reqId} {
      allow read: if isLoggedIn();
      allow create, update: if isLoggedIn() && (request.auth.uid == reqId || request.resource.data.user_id == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    // ─── Admin Notifications ──────────────────────────────────────────────────
    match /admin_notifications/{notifId} {
      allow read, update, delete: if isAdmin();
      allow create: if isLoggedIn();
    }

  }
}
