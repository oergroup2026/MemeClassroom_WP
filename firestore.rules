rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: any signed-in user
    function isLoggedIn() {
      return request.auth != null;
    }

    // Helper: the requesting user owns this document
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Helper: check if the requesting user has admin role
    function isAdmin() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Helper: check if user is expert or admin
    function isExpertOrAdmin() {
      return request.auth != null && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'expert' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    // Roles a user may assign to their OWN profile at registration. Must stay in
    // sync with REGISTER_ROLES in src/pages/Auth.jsx — the signup screen offers
    // exactly these five. Privileged roles ('expert', 'admin', 'manager') are
    // deliberately absent: they are granted by an admin only (see /expert_apps).
    function isSelfAssignableRole(role) {
      return role in ['student', 'teacher', 'research', 'parent', 'other'];
    }

    // Helper: check if the requesting user's own profile is banned.
    // Used to block content creation server-side — the app only redirects
    // banned users client-side (App.jsx), which a direct Firestore write bypasses.
    function isBanned() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.banned == true;
    }

    // ─── Users ──────────────────────────────────────────────────────────────
    // This document holds the user's school/institution, town, state and
    // country. It was readable by ANY signed-in user, so since registration is
    // open to the public, anyone could enumerate the name, school and location
    // of every student on the platform.
    //
    // Reads are now limited to the owner and admins. Pages that just need to
    // show an author's name and avatar read /user_cards/{uid} instead, which a
    // Cloud Function mirrors from this document (see functions/index.js).
    //
    // Admins can read and write any profile. Non-admin users can only create/update
    // their own profile with a self-assignable role, and cannot self-grant admin,
    // expert, verified, or banned status.
    match /users/{userId} {
      allow read: if isLoggedIn() && (isOwner(userId) || isAdmin());
      allow create: if isLoggedIn() && (
        isAdmin() ||
        (isOwner(userId) && isSelfAssignableRole(request.resource.data.role))
      );
      allow update: if isLoggedIn() && (
        isAdmin() ||
        (isOwner(userId) && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'is_verified', 'banned'])
        ))
      );
      allow delete: if isAdmin();

      // Private subcollection for sensitive PII (ID Card verification URL, etc.)
      match /private/{docId} {
        allow read, write: if isLoggedIn() && (isOwner(userId) || isAdmin());
      }
    }

    // ─── Public Profile Cards ─────────────────────────────────────────────────
    // The display-only projection of /users/{uid}: name, role, is_verified,
    // avatar_url, tagline. Nothing here identifies where a user studies or
    // lives. Written ONLY by the mirrorUserCard Cloud Function, which runs with
    // the Admin SDK and bypasses these rules — clients are denied all writes, so
    // a user cannot forge or alter another user's card.
    //
    // Public read, per the project's access policy: all content is browsable
    // without an account and only contributing requires one. Memes, resources
    // and comments are already public, so their author attribution must be too
    // — the old rule required a login, which left every guest looking at
    // "Unknown User" on otherwise public pages.
    match /user_cards/{userId} {
      allow read: if true;
      allow write: if false;
    }

    // ─── Private Contacts (email addresses) ───────────────────────────────────
    // Email lives here instead of on /users/{userId} so that the "any logged-in
    // user can read /users" rule above doesn't hand every authenticated user
    // everyone else's email address. Owner + admin only.
    match /private_contacts/{userId} {
      allow read, write: if isLoggedIn() && (isOwner(userId) || isAdmin());
    }

    // ─── Memes ──────────────────────────────────────────────────────────────
    // Public memes are readable by all (including guests browsing the library).
    // Private/draft memes are only readable by their creator or admin.
    match /memes/{memeId} {
      allow read: if resource.data.visibility == "public" || (
        isLoggedIn() && (
          resource.data.creator_id == request.auth.uid ||
          isAdmin()
        )
      );
      allow create: if isLoggedIn() && !isBanned() && request.resource.data.creator_id == request.auth.uid;
      allow update: if isLoggedIn() && (
        isAdmin() ||
        // The creator may edit their own meme, but not its moderation counter —
        // otherwise anyone whose content was reported could simply zero their
        // own flag_count and drop off the moderation queue.
        (
          resource.data.creator_id == request.auth.uid &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['flag_count'])
        ) ||
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes_count']) &&
          (request.resource.data.likes_count == resource.data.likes_count + 1 || request.resource.data.likes_count == resource.data.likes_count - 1)
        ) ||
        // Reporting is increment-only. Allowing -1 let anyone repeatedly
        // decrement a reported item's counter and un-report it; the client only
        // ever increments. Clearing a flag after review is an admin action.
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['flag_count']) &&
          request.resource.data.flag_count == resource.data.flag_count + 1
        )
      );
      allow delete: if isLoggedIn() && (
        resource.data.creator_id == request.auth.uid || isAdmin()
      );
    }

    // ─── Templates ──────────────────────────────────────────────────────────
    // Only approved templates are publicly visible (including to unauthenticated guests).
    // Any authenticated user can contribute (create) a template for approval.
    // Only admins can approve, update status, or delete templates.
    match /templates/{templateId} {
      allow read: if resource.data.status == "approved" || (
        isLoggedIn() && (
          resource.data.creator_id == request.auth.uid ||
          isAdmin()
        )
      );
      // Creation previously required only being signed in, with no check on
      // creator_id or status — so a user could submit a template already marked
      // status: "approved" and publish it straight to the public library, which
      // guests can read. Contributors must now claim their own submission and
      // leave it unapproved; only admins can create an approved template.
      allow create: if isLoggedIn() && !isBanned() && (
        isAdmin() ||
        (
          request.resource.data.creator_id == request.auth.uid &&
          request.resource.data.status != "approved"
        )
      );
      allow update, delete: if isAdmin();
    }

    // ─── Taxonomy Counters ───────────────────────────────────────────────────
    // Authenticated users can write counts; only admin reads all counts.
    match /custom_counts/{docId} {
      allow read: if isAdmin();
      allow write: if isLoggedIn();
    }

    // ─── Shared Config (taxonomy, etc.) ─────────────────────────────────────
    match /configs/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── User Stats ──────────────────────────────────────────────────────────
    match /user_stats/{userId} {
      allow read: if isLoggedIn();
      allow create: if isLoggedIn() && (isOwner(userId) || isAdmin());
      allow update: if isLoggedIn() && (
        isOwner(userId) ||
        isAdmin() ||
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['total_likes_received']) &&
          (request.resource.data.total_likes_received == resource.data.total_likes_received + 1 || request.resource.data.total_likes_received == resource.data.total_likes_received - 1)
        )
      );
      allow delete: if isLoggedIn() && (isOwner(userId) || isAdmin());
    }

    // ─── Expert Applications ──────────────────────────────────────────────────
    match /expert_apps/{appId} {
      allow read, update, delete: if isAdmin();
      allow create: if isLoggedIn() && request.resource.data.user_id == request.auth.uid;
    }

    // ─── Comments ───────────────────────────────────────────────────────────
    // Only an expert/admin may mark a comment as an expert comment.
    function expertFlagIsPermitted() {
      return !request.resource.data.keys().hasAll(['is_expert_comment']) ||
             request.resource.data.is_expert_comment != true ||
             isExpertOrAdmin();
    }

    match /comments/{commentId} {
      allow read: if true;
      allow create: if isLoggedIn() && !isBanned()
        && request.resource.data.user_id == request.auth.uid
        && expertFlagIsPermitted();
      // Editing previously required only "signed in and not banned" — with no
      // check that you wrote the comment, any user could rewrite anyone else's
      // words while their name stayed on it. Restrict to the author (and
      // admins, for moderation), and do not let an edit reassign authorship.
      allow update: if isLoggedIn() && !isBanned()
        && expertFlagIsPermitted()
        && (
          isAdmin() ||
          (
            resource.data.user_id == request.auth.uid &&
            request.resource.data.user_id == resource.data.user_id
          )
        );
      allow delete: if isLoggedIn() && resource.data.user_id == request.auth.uid;
      allow delete: if isAdmin();
    }

    // ─── Staffroom Posts ─────────────────────────────────────────────────────
    match /staffroom_posts/{postId} {
      allow read: if isLoggedIn();
      allow create: if isLoggedIn() && !isBanned();
      allow update: if isLoggedIn() && (
        resource.data.author_id == request.auth.uid ||
        isAdmin() ||
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['title', 'body', 'author_id', 'post_type', 'attachment_url', 'attachment_name', 'created_at', 'subject', 'grade', 'is_solved', 'is_announcement'])
      );
      allow delete: if isLoggedIn() && resource.data.author_id == request.auth.uid;
      allow delete: if isAdmin();
    }

    // ─── Staffroom Replies ───────────────────────────────────────────────────
    match /staffroom_replies/{replyId} {
      allow read: if isLoggedIn();
      allow create: if isLoggedIn() && !isBanned();
      allow update: if isLoggedIn() && (resource.data.author_id == request.auth.uid || isAdmin());
      allow delete: if isLoggedIn() && resource.data.author_id == request.auth.uid;
      allow delete: if isAdmin() || isExpertOrAdmin();
    }

    // ─── Resources ───────────────────────────────────────────────────────────
    // Author cannot self-approve on create, and cannot flip admin_approved to
    // true on update — mirrors the /newspaper_items pattern below, closing the
    // self-approval gap this file used to call out in a comment but not fix.
    match /resources/{resourceId} {
      allow read: if true;
      allow create: if isLoggedIn() && !isBanned() && (
        isAdmin() ||
        (request.resource.data.author_id == request.auth.uid && request.resource.data.admin_approved == false)
      );
      allow update: if isLoggedIn() && (
        isAdmin() ||
        (
          resource.data.author_id == request.auth.uid &&
          (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['admin_approved']) ||
            request.resource.data.admin_approved == false
          ) &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'author_id', 'flag_count'])
        ) ||
        // Reporting a resource (ActivityDetail, MemeStoryDetail, Resources) is
        // an increment by a user who is NOT the author, which the author-only
        // clause above rejected — so flagging a resource silently failed for
        // everyone it was meant for. Increment-only, like /memes.
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['flag_count']) &&
          request.resource.data.flag_count == resource.data.flag_count + 1
        ) ||
        // Comment counter maintained by activity commenters, likewise not the author.
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['comments_count']) &&
          (request.resource.data.comments_count == resource.data.comments_count + 1 ||
           request.resource.data.comments_count == resource.data.comments_count - 1)
        )
      );
      allow delete: if isLoggedIn() && (resource.data.author_id == request.auth.uid || isAdmin());
    }

    // ─── External Links / Additional Tools ────────────────────────────────────
    // Publicly readable, so an unapproved entry is a link shown to students.
    // Creation previously required only being signed in, with no check on
    // contributor_id and no approval gate. Contributors must now claim their own
    // submission, leave it unapproved, and cannot self-approve on update.
    match /external_links/{linkId} {
      allow read: if true;
      allow create: if isLoggedIn() && !isBanned() && (
        isAdmin() ||
        (
          request.resource.data.contributor_id == request.auth.uid &&
          request.resource.data.admin_approved == false
        )
      );
      allow update: if isLoggedIn() && (
        isAdmin() ||
        (
          resource.data.contributor_id == request.auth.uid &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['admin_approved', 'contributor_id'])
        )
      );
      allow delete: if isLoggedIn() && (resource.data.contributor_id == request.auth.uid || isAdmin());
    }

    // ─── Newspaper Items ───────────────────────────────────────────────────────
    // Public read (including guests). Any logged-in user can submit, but only
    // admins can flip admin_approved/status — closes the gap that exists on
    // /resources today where an author can self-approve their own submission.
    match /newspaper_items/{itemId} {
      allow read: if true;
      allow create: if isLoggedIn() && !isBanned() && (
        isAdmin() ||
        (request.resource.data.author_id == request.auth.uid && request.resource.data.admin_approved == false)
      );
      allow update: if isLoggedIn() && (
        isAdmin() ||
        (
          resource.data.author_id == request.auth.uid &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['admin_approved', 'status', 'author_id', 'view_count', 'likes_count', 'flag_count'])
        )
      );
      allow delete: if isLoggedIn() && (resource.data.author_id == request.auth.uid || isAdmin());
    }

    // ─── Newspaper Likes ─────────────────────────────────────────────────────
    match /newspaper_likes/{likeId} {
      allow read: if isLoggedIn();
      allow create: if isLoggedIn() && request.resource.data.user_id == request.auth.uid;
      allow update, delete: if isLoggedIn() && (resource.data.user_id == request.auth.uid || isAdmin());
    }

    // ─── Saves (Bookmarks) ───────────────────────────────────────────────────
    match /saves/{saveId} {
      allow read: if isLoggedIn() && (resource.data.user_id == request.auth.uid || isAdmin());
      allow create: if isLoggedIn() && request.resource.data.user_id == request.auth.uid;
      allow update, delete: if isLoggedIn() && (resource.data.user_id == request.auth.uid || isAdmin());
    }

    // ─── Resource Likes ──────────────────────────────────────────────────────
    match /resource_likes/{likeId} {
      allow read: if isLoggedIn();
      allow create: if isLoggedIn() && request.resource.data.user_id == request.auth.uid;
      allow update, delete: if isLoggedIn() && (resource.data.user_id == request.auth.uid || isAdmin());
    }

    // ─── Likes ───────────────────────────────────────────────────────────────
    match /likes/{likeId} {
      allow read: if isLoggedIn();
      allow create: if isLoggedIn() && request.resource.data.user_id == request.auth.uid;
      allow delete: if isLoggedIn() && (resource.data.user_id == request.auth.uid || isAdmin());
    }

    // ─── Ratings ─────────────────────────────────────────────────────────────
    match /ratings/{ratingId} {
      allow read: if true;
      allow create, update: if isLoggedIn() && request.resource.data.user_id == request.auth.uid;
      allow delete: if isLoggedIn() && (resource.data.user_id == request.auth.uid || isAdmin());
    }

    // ─── Flags (Reports) ─────────────────────────────────────────────────────
    match /flags/{flagId} {
      allow read: if isLoggedIn() && (resource.data.reporter_id == request.auth.uid || isAdmin());
      allow create: if isLoggedIn() && request.resource.data.reporter_id == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // ─── Literacy Tests ────────────────────────────────────────────────────────
    // Active tests are publicly readable; only admins can create/update/delete.
    match /literacy_tests/{testId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ─── Literacy Test Questions ───────────────────────────────────────────────
    // Questions are publicly readable (needed to run the quiz); only admins can write.
    match /literacy_test_questions/{questionId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ─── Literacy Test Results ────────────────────────────────────────────────
    // Users can write only their own results; they can read their own results; admins see all.
    match /literacy_test_results/{resultId} {
      allow read: if isLoggedIn() && (resource.data.user_id == request.auth.uid || isAdmin());
      allow create: if isLoggedIn() && request.resource.data.user_id == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // ─── Literacy Badges ──────────────────────────────────────────────────────
    // Users earn badges on passing tests; they can read their own; admins see all.
    match /literacy_badges/{badgeId} {
      allow read: if isLoggedIn() && (resource.data.user_id == request.auth.uid || isAdmin());
      allow create: if isLoggedIn() && request.resource.data.user_id == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // ─── Slang Terms (Slang Decoder dictionary) ───────────────────────────────
    // Public read (anyone can browse approved entries; the client filters to
    // status == "approved" for the public grid). Contributors can create their
    // own pending entry but cannot self-approve; admins can approve/edit/delete any.
    match /slang_terms/{termId} {
      allow read: if true;
      allow create: if isLoggedIn() && !isBanned() && (
        isAdmin() ||
        (request.resource.data.contributor_id == request.auth.uid && request.resource.data.admin_approved == false)
      );
      allow update: if isLoggedIn() && (
        isAdmin() ||
        (
          resource.data.contributor_id == request.auth.uid &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['admin_approved', 'status', 'contributor_id'])
        )
      );
      allow delete: if isLoggedIn() && (resource.data.contributor_id == request.auth.uid || isAdmin());
    }

    // ─── Slang Quiz Questions ──────────────────────────────────────────────────
    // Curated question bank for the Slang Decoder quiz; publicly readable
    // (needed to run the quiz), only admins can write — same shape as literacy tests.
    match /slang_quiz_questions/{questionId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ─── Slang Quiz Results ────────────────────────────────────────────────────
    // Users can write only their own results; they can read their own results; admins see all.
    match /slang_quiz_results/{resultId} {
      allow read: if isLoggedIn() && (resource.data.user_id == request.auth.uid || isAdmin());
      allow create: if isLoggedIn() && request.resource.data.user_id == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // ─── Notifications ────────────────────────────────────────────────────────
    // Users can read and mark-as-read their own notifications only.
    // Cloud Functions (service account) create/delete — not direct client writes.
    match /notifications/{notifId} {
      allow read: if isLoggedIn() && resource.data.user_id == request.auth.uid;
      allow update: if isLoggedIn() && resource.data.user_id == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow create, delete: if false; // Written only by Cloud Functions service account
    }

    // ─── Unban Requests ───────────────────────────────────────────────────────
    match /unban_requests/{reqId} {
      allow read: if isLoggedIn();
      allow create, update: if isLoggedIn() && (request.auth.uid == reqId || request.resource.data.user_id == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    // ─── Badges ──────────────────────────────────────────────────────────────
    // Awarded by awardBadgeIfMissing() in src/utils/badges.js, which first
    // queries this collection for the signed-in user's existing badges and then
    // creates one. With no rule here the whole gamification system failed
    // silently — every read and write was denied by default and the helper
    // swallowed the error, so no badge was ever awarded to anyone.
    // Readable by signed-in users (profiles display other users' badges);
    // a user may only create badges for themselves. Edits/removals are admin-only
    // so a user cannot retroactively rewrite their own achievements.
    match /badges/{badgeId} {
      allow read: if isLoggedIn();
      allow create: if isLoggedIn() && request.resource.data.user_id == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // ─── Activity Comments ────────────────────────────────────────────────────
    // Comments on an activity resource (ActivityDetail.jsx). Activities are
    // publicly readable, so comments are too. Authors may delete their own;
    // admins may moderate any. Note this collection uses author_id, unlike
    // /comments which uses user_id.
    match /activity_comments/{commentId} {
      allow read: if true;
      allow create: if isLoggedIn() && !isBanned() && request.resource.data.author_id == request.auth.uid;
      allow update: if isLoggedIn() && (resource.data.author_id == request.auth.uid || isAdmin());
      allow delete: if isLoggedIn() && (resource.data.author_id == request.auth.uid || isAdmin());
    }

    // ─── Legacy Threads (global search index only) ────────────────────────────
    // Navbar.jsx reads this inside a Promise.all alongside memes and resources.
    // Without a rule the denial rejected the whole batch, so the global search
    // box indexed nothing at all — not even memes. Read-only for clients.
    match /threads/{threadId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── Homepage Hero Cards, Sponsored Ads, Testimonials ─────────────────────
    // All three are published from the Admin panel and displayed publicly on the
    // homepage, so: public read, admin-only write.
    match /heroCards/{cardId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /sponsored_ads/{adId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /testimonials/{testimonialId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── Admin Notifications ──────────────────────────────────────────────────
    match /admin_notifications/{notifId} {
      allow read, update, delete: if isAdmin();
      allow create: if isLoggedIn();
    }

  }
}
